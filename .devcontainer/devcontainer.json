{
    "name": "Welcome to Codespaces (Java)",
    "image": "mcr.microsoft.com/devcontainers/java:21",
    "features": {
        "ghcr.io/devcontainers-extra/features/kotlin-sdkman:2": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "installGradle": false,
            "installMaven": false
        },
        "ghcr.io/devcontainers/features/aws-cli:1":{
            "version": "latest"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "eadmodio.gitlens"
            ]
        }
    },
    "postCreateCommand": "java -version && javac -version"
}
